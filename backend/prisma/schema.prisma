model work_evidence {
  work_evidence_id     BigInt                 @id @default(autoincrement())
  provider_profile_id  BigInt
  description          String                 @db.VarChar(300)
  status_id            Int                    @db.SmallInt
  reviewed_by          BigInt?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  provider_profiles    provider_profiles      @relation(fields: [provider_profile_id], references: [provider_profile_id], onDelete: NoAction, onUpdate: NoAction)
  users                users?                 @relation(fields: [reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  evidence_statuses    evidence_statuses      @relation(fields: [status_id], references: [evidence_status_id], onDelete: NoAction, onUpdate: NoAction)
