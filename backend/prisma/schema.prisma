generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model account_statuses {
  status_id   Int     @id @default(autoincrement()) @db.SmallInt
  status_name String  @unique @db.VarChar(30)
  users       users[]
}

model active_profiles {
  active_profile_id Int     @id @default(autoincrement()) @db.SmallInt
  profile_name      String  @unique @db.VarChar(20)
  users             users[]
}

model appointment_reschedule_requests {
  reschedule_request_id BigInt              @id @default(autoincrement())
  appointment_id        BigInt
  requested_by          BigInt
  previous_datetime     DateTime            @db.Timestamptz(6)
  new_datetime          DateTime            @db.Timestamptz(6)
  status_id             Int                 @db.SmallInt
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  appointments          appointments        @relation(fields: [appointment_id], references: [appointment_id], onDelete: NoAction, onUpdate: NoAction)
  users                 users               @relation(fields: [requested_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  reschedule_statuses   reschedule_statuses @relation(fields: [status_id], references: [reschedule_status_id], onDelete: NoAction, onUpdate: NoAction)
}

model appointment_statuses {
  appointment_status_id Int            @id @default(autoincrement()) @db.SmallInt
  status_name           String         @unique @db.VarChar(20)
  appointments          appointments[]
}

model appointments {
  appointment_id                  BigInt                            @id @default(autoincrement())
  service_request_id              BigInt                            @unique
  scheduled_datetime              DateTime                          @db.Timestamptz(6)
  status_id                       Int                               @db.SmallInt
  created_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  appointment_reschedule_requests appointment_reschedule_requests[]
  service_requests                service_requests                  @relation(fields: [service_request_id], references: [service_request_id], onDelete: NoAction, onUpdate: NoAction)
  appointment_statuses            appointment_statuses              @relation(fields: [status_id], references: [appointment_status_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([scheduled_datetime], map: "idx_appointments_scheduled")
}

model audit_events {
  audit_event_id BigInt   @id @default(autoincrement())
  actor_id       BigInt?
  event_type     String   @db.VarChar(50)
  entity_type    String   @db.VarChar(50)
  entity_id      BigInt
  occurred_at    DateTime @default(now()) @db.Timestamptz(6)
  users          users?   @relation(fields: [actor_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_id], map: "idx_audit_events_actor")
  @@index([entity_type, entity_id], map: "idx_audit_events_entity")
  @@index([occurred_at], map: "idx_audit_events_occurred")
}

model auth_tokens {
  auth_token_id BigInt      @id @default(autoincrement())
  user_id       BigInt
  token_type_id Int         @db.SmallInt
  token_hash    String      @unique @db.VarChar(255)
  expires_at    DateTime    @db.Timestamptz(6)
  used_at       DateTime?   @db.Timestamptz(6)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  token_types   token_types @relation(fields: [token_type_id], references: [token_type_id], onDelete: NoAction, onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "idx_auth_tokens_user")
}

model bank_account_types {
  account_type_id        Int                      @id @default(autoincrement()) @db.SmallInt
  type_name              String                   @unique @db.VarChar(20)
  provider_bank_accounts provider_bank_accounts[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cancellations {
  cancellation_id                                      BigInt                  @id @default(autoincrement())
  service_request_id                                   BigInt                  @unique
  cancelled_by                                         BigInt
  reason                                               String                  @db.VarChar(500)
  is_force_majeure                                     Boolean                 @default(false)
  evidence_url                                         String?                 @db.VarChar(255)
  force_majeure_status_id                              Int?                    @db.SmallInt
  force_majeure_reviewed_by                            BigInt?
  created_at                                           DateTime                @default(now()) @db.Timestamptz(6)
  users_cancellations_cancelled_byTousers              users                   @relation("cancellations_cancelled_byTousers", fields: [cancelled_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_cancellations_force_majeure_reviewed_byTousers users?                  @relation("cancellations_force_majeure_reviewed_byTousers", fields: [force_majeure_reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  force_majeure_statuses                               force_majeure_statuses? @relation(fields: [force_majeure_status_id], references: [force_majeure_status_id], onDelete: NoAction, onUpdate: NoAction)
  service_requests                                     service_requests        @relation(fields: [service_request_id], references: [service_request_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model categories {
  category_id         Int                   @id @default(autoincrement())
  parent_category_id  Int?
  category_name       String                @db.VarChar(100)
  categories          categories?           @relation("categoriesTocategories", fields: [parent_category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  other_categories    categories[]          @relation("categoriesTocategories")
  needs               needs[]
  provider_categories provider_categories[]
  service_listings    service_listings[]

  @@unique([parent_category_id, category_name])
}

model chat_messages {
  message_id         BigInt           @id @default(autoincrement())
  service_request_id BigInt
  sender_id          BigInt
  message_text       String           @db.VarChar(2000)
  sent_at            DateTime         @default(now()) @db.Timestamptz(6)
  users              users            @relation(fields: [sender_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  service_requests   service_requests @relation(fields: [service_request_id], references: [service_request_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([service_request_id, sent_at], map: "idx_chat_messages_request_sent")
}

model claim_photos {
  claim_photo_id BigInt @id @default(autoincrement())
  claim_id       BigInt
  photo_url      String @db.VarChar(255)
  claims         claims @relation(fields: [claim_id], references: [claim_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([claim_id], map: "idx_claim_photos_claim")
}

model claim_reasons {
  claim_reason_id Int      @id @default(autoincrement()) @db.SmallInt
  reason_name     String   @unique @db.VarChar(100)
  claims          claims[]
}

model claim_statuses {
  claim_status_id Int      @id @default(autoincrement()) @db.SmallInt
  status_name     String   @unique @db.VarChar(30)
  claims          claims[]
}

model claims {
  claim_id                          BigInt           @id @default(autoincrement())
  service_request_id                BigInt
  filed_by                          BigInt
  filed_against                     BigInt
  reason_id                         Int              @db.SmallInt
  description                       String           @db.VarChar(1000)
  status_id                         Int              @db.SmallInt
  resolution                        String?          @db.VarChar(1000)
  created_at                        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime         @default(now()) @db.Timestamptz(6)
  claim_photos                      claim_photos[]
  users_claims_filed_againstTousers users            @relation("claims_filed_againstTousers", fields: [filed_against], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_claims_filed_byTousers      users            @relation("claims_filed_byTousers", fields: [filed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  claim_reasons                     claim_reasons    @relation(fields: [reason_id], references: [claim_reason_id], onDelete: NoAction, onUpdate: NoAction)
  service_requests                  service_requests @relation(fields: [service_request_id], references: [service_request_id], onDelete: NoAction, onUpdate: NoAction)
  claim_statuses                    claim_statuses   @relation(fields: [status_id], references: [claim_status_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([service_request_id], map: "idx_claims_service_request")
  @@index([status_id, created_at], map: "idx_claims_status_created")
}

model client_profiles {
  client_profile_id         BigInt         @id @default(autoincrement())
  user_id                   BigInt         @unique
  reference_neighborhood_id Int?
  reference_address         String?        @db.VarChar(255)
  description               String?        @db.VarChar(200)
  created_at                DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                DateTime       @default(now()) @db.Timestamptz(6)
  neighborhoods             neighborhoods? @relation(fields: [reference_neighborhood_id], references: [neighborhood_id], onDelete: NoAction, onUpdate: NoAction)
  users                     users          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model communes {
  commune_id    Int             @id @default(autoincrement())
  commune_name  String          @unique @db.VarChar(100)
  neighborhoods neighborhoods[]
}

model completion_confirmations {
  completion_confirmation_id BigInt           @id @default(autoincrement())
  service_request_id         BigInt
  confirmed_by               BigInt
  is_automatic               Boolean          @default(false)
  confirmed_at               DateTime         @default(now()) @db.Timestamptz(6)
  users                      users            @relation(fields: [confirmed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  service_requests           service_requests @relation(fields: [service_request_id], references: [service_request_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([service_request_id, confirmed_by])
}

model days_of_week {
  day_of_week_id        Int                     @id @default(autoincrement()) @db.SmallInt
  day_name              String                  @unique @db.VarChar(10)
  provider_availability provider_availability[]
}

model document_types {
  document_type_id       Int                      @id @default(autoincrement()) @db.SmallInt
  type_name              String                   @unique @db.VarChar(30)
  identity_verifications identity_verifications[]
}

model evidence_statuses {
  evidence_status_id Int             @id @default(autoincrement()) @db.SmallInt
  status_name        String          @unique @db.VarChar(30)
  work_evidence      work_evidence[]
}

model force_majeure_statuses {
  force_majeure_status_id Int             @id @default(autoincrement()) @db.SmallInt
  status_name             String          @unique @db.VarChar(20)
  cancellations           cancellations[]
}

model identity_verification_photos {
  identity_verification_photo_id BigInt                 @id @default(autoincrement())
  identity_verification_id       BigInt
  photo_url                      String                 @db.VarChar(255)
  identity_verifications         identity_verifications @relation(fields: [identity_verification_id], references: [identity_verification_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([identity_verification_id], map: "idx_identity_verification_photos_verification")
}

model identity_verifications {
  identity_verification_id     BigInt                         @id @default(autoincrement())
  provider_profile_id          BigInt
  document_type_id             Int                            @db.SmallInt
  document_number              String                         @db.VarChar(30)
  additional_info              String?                        @db.VarChar(500)
  status_id                    Int                            @db.SmallInt
  reviewed_by                  BigInt?
  review_notes                 String?                        @db.VarChar(500)
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  identity_verification_photos identity_verification_photos[]
  document_types               document_types                 @relation(fields: [document_type_id], references: [document_type_id], onDelete: NoAction, onUpdate: NoAction)
  provider_profiles            provider_profiles              @relation(fields: [provider_profile_id], references: [provider_profile_id], onDelete: NoAction, onUpdate: NoAction)
  users                        users?                         @relation(fields: [reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  verification_statuses        verification_statuses          @relation(fields: [status_id], references: [verification_status_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([provider_profile_id, created_at(sort: Desc)], map: "idx_identity_verifications_provider_created")
}

model interest_statuses {
  interest_status_id Int              @id @default(autoincrement()) @db.SmallInt
  status_name        String           @unique @db.VarChar(20)
  need_interests     need_interests[]
}

model issue_reports {
  issue_report_id    BigInt           @id @default(autoincrement())
  service_request_id BigInt
  reported_by        BigInt
  description        String           @db.VarChar(1000)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  users              users            @relation(fields: [reported_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  service_requests   service_requests @relation(fields: [service_request_id], references: [service_request_id], onDelete: NoAction, onUpdate: NoAction)
}

model listing_statuses {
  listing_status_id Int                @id @default(autoincrement()) @db.SmallInt
  status_name       String             @unique @db.VarChar(20)
  service_listings  service_listings[]
}

model need_interests {
  need_interest_id    BigInt            @id @default(autoincrement())
  need_id             BigInt
  provider_profile_id BigInt
  message             String?           @db.VarChar(500)
  proposed_price      Decimal?          @db.Decimal(12, 2)
  status_id           Int               @db.SmallInt
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  needs               needs             @relation(fields: [need_id], references: [need_id], onDelete: NoAction, onUpdate: NoAction)
  provider_profiles   provider_profiles @relation(fields: [provider_profile_id], references: [provider_profile_id], onDelete: NoAction, onUpdate: NoAction)
  interest_statuses   interest_statuses @relation(fields: [status_id], references: [interest_status_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([need_id, provider_profile_id])
  @@index([provider_profile_id], map: "idx_need_interests_provider")
}

model need_photos {
  need_photo_id BigInt @id @default(autoincrement())
  need_id       BigInt
  photo_url     String @db.VarChar(255)
  needs         needs  @relation(fields: [need_id], references: [need_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([need_id], map: "idx_need_photos_need")
}

model need_statuses {
  need_status_id Int     @id @default(autoincrement()) @db.SmallInt
  status_name    String  @unique @db.VarChar(30)
  needs          needs[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model needs {
  need_id            BigInt             @id @default(autoincrement())
  client_id          BigInt
  title              String             @db.VarChar(150)
  description        String             @db.VarChar(1000)
  category_id        Int
  neighborhood_id    Int
  exact_address      String?            @db.VarChar(255)
  preferred_datetime DateTime?          @db.Timestamptz(6)
  budget_min         Decimal?           @db.Decimal(12, 2)
  budget_max         Decimal?           @db.Decimal(12, 2)
  status_id          Int                @db.SmallInt
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)
  need_interests     need_interests[]
  need_photos        need_photos[]
  categories         categories         @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  users              users              @relation(fields: [client_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  neighborhoods      neighborhoods      @relation(fields: [neighborhood_id], references: [neighborhood_id], onDelete: NoAction, onUpdate: NoAction)
  need_statuses      need_statuses      @relation(fields: [status_id], references: [need_status_id], onDelete: NoAction, onUpdate: NoAction)
  service_requests   service_requests[]

  @@index([category_id, status_id], map: "idx_needs_category_status")
  @@index([client_id], map: "idx_needs_client")
}

model neighborhoods {
  neighborhood_id        Int                      @id @default(autoincrement())
  commune_id             Int
  neighborhood_name      String                   @db.VarChar(100)
  client_profiles        client_profiles[]
  needs                  needs[]
  communes               communes                 @relation(fields: [commune_id], references: [commune_id], onDelete: NoAction, onUpdate: NoAction)
  provider_service_areas provider_service_areas[]
  service_requests       service_requests[]

  @@unique([commune_id, neighborhood_name])
}

model notification_types {
  notification_type_id Int             @id @default(autoincrement()) @db.SmallInt
  type_name            String          @unique @db.VarChar(50)
  notifications        notifications[]
}

model notifications {
  notification_id            BigInt             @id @default(autoincrement())
  user_id                    BigInt
  notification_type_id       Int                @db.SmallInt
  message                    String             @db.VarChar(300)
  related_service_request_id BigInt?
  is_read                    Boolean            @default(false)
  created_at                 DateTime           @default(now()) @db.Timestamptz(6)
  notification_types         notification_types @relation(fields: [notification_type_id], references: [notification_type_id], onDelete: NoAction, onUpdate: NoAction)
  service_requests           service_requests?  @relation(fields: [related_service_request_id], references: [service_request_id], onDelete: NoAction, onUpdate: NoAction)
  users                      users              @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, is_read], map: "idx_notifications_user_read")
}

model provider_availability {
  provider_availability_id BigInt            @id @default(autoincrement())
  provider_profile_id      BigInt
  day_of_week_id           Int               @db.SmallInt
  time_block_id            Int               @db.SmallInt
  days_of_week             days_of_week      @relation(fields: [day_of_week_id], references: [day_of_week_id], onDelete: NoAction, onUpdate: NoAction)
  provider_profiles        provider_profiles @relation(fields: [provider_profile_id], references: [provider_profile_id], onDelete: NoAction, onUpdate: NoAction)
  time_blocks              time_blocks       @relation(fields: [time_block_id], references: [time_block_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([provider_profile_id, day_of_week_id, time_block_id])
  @@index([provider_profile_id], map: "idx_provider_availability_provider")
}

model provider_bank_accounts {
  provider_bank_account_id BigInt             @id @default(autoincrement())
  provider_profile_id      BigInt             @unique
  bank_name                String             @db.VarChar(100)
  account_type_id          Int                @db.SmallInt
  account_number           String             @db.VarChar(30)
  created_at               DateTime           @default(now()) @db.Timestamptz(6)
  updated_at               DateTime           @default(now()) @db.Timestamptz(6)
  bank_account_types       bank_account_types @relation(fields: [account_type_id], references: [account_type_id], onDelete: NoAction, onUpdate: NoAction)
  provider_profiles        provider_profiles  @relation(fields: [provider_profile_id], references: [provider_profile_id], onDelete: NoAction, onUpdate: NoAction)
}

model provider_categories {
  provider_profile_id BigInt
  category_id         Int
  categories          categories        @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  provider_profiles   provider_profiles @relation(fields: [provider_profile_id], references: [provider_profile_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([provider_profile_id, category_id])
  @@index([category_id], map: "idx_provider_categories_category")
}

model provider_profiles {
  provider_profile_id    BigInt                   @id @default(autoincrement())
  user_id                BigInt                   @unique
  nit                    String?                  @unique @db.VarChar(20)
  bio                    String?                  @db.VarChar(500)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  identity_verifications identity_verifications[]
  need_interests         need_interests[]
  provider_availability  provider_availability[]
  provider_bank_accounts provider_bank_accounts?
  provider_categories    provider_categories[]
  users                  users                    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  provider_service_areas provider_service_areas[]
  service_listings       service_listings[]
  service_requests       service_requests[]
  work_evidence          work_evidence[]
}

model provider_service_areas {
  provider_profile_id BigInt
  neighborhood_id     Int
  neighborhoods       neighborhoods     @relation(fields: [neighborhood_id], references: [neighborhood_id], onDelete: NoAction, onUpdate: NoAction)
  provider_profiles   provider_profiles @relation(fields: [provider_profile_id], references: [provider_profile_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([provider_profile_id, neighborhood_id])
  @@index([neighborhood_id], map: "idx_provider_service_areas_neighborhood")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ratings {
  rating_id                          BigInt           @id @default(autoincrement())
  service_request_id                 BigInt
  rated_by                           BigInt
  rated_user_id                      BigInt
  score                              Int              @db.SmallInt
  comment                            String?          @db.VarChar(300)
  created_at                         DateTime         @default(now()) @db.Timestamptz(6)
  users_ratings_rated_byTousers      users            @relation("ratings_rated_byTousers", fields: [rated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_ratings_rated_user_idTousers users            @relation("ratings_rated_user_idTousers", fields: [rated_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  service_requests                   service_requests @relation(fields: [service_request_id], references: [service_request_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([service_request_id, rated_by])
  @@index([rated_by], map: "idx_ratings_rated_by")
  @@index([rated_user_id], map: "idx_ratings_rated_user")
}

model request_statuses {
  request_status_id Int                @id @default(autoincrement()) @db.SmallInt
  status_name       String             @unique @db.VarChar(30)
  service_requests  service_requests[]
}

model reschedule_statuses {
  reschedule_status_id            Int                               @id @default(autoincrement()) @db.SmallInt
  status_name                     String                            @unique @db.VarChar(20)
  appointment_reschedule_requests appointment_reschedule_requests[]
}

model service_listing_photos {
  service_listing_photo_id BigInt           @id @default(autoincrement())
  service_listing_id       BigInt
  photo_url                String           @db.VarChar(255)
  service_listings         service_listings @relation(fields: [service_listing_id], references: [service_listing_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([service_listing_id], map: "idx_service_listing_photos_listing")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model service_listings {
  service_listing_id     BigInt                   @id @default(autoincrement())
  provider_profile_id    BigInt
  category_id            Int
  title                  String                   @db.VarChar(150)
  description            String                   @db.VarChar(1000)
  min_price              Decimal                  @db.Decimal(12, 2)
  max_price              Decimal                  @db.Decimal(12, 2)
  status_id              Int                      @db.SmallInt
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  service_listing_photos service_listing_photos[]
  categories             categories               @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  provider_profiles      provider_profiles        @relation(fields: [provider_profile_id], references: [provider_profile_id], onDelete: NoAction, onUpdate: NoAction)
  listing_statuses       listing_statuses         @relation(fields: [status_id], references: [listing_status_id], onDelete: NoAction, onUpdate: NoAction)
  service_requests       service_requests[]

  @@index([category_id, status_id], map: "idx_service_listings_category_status")
  @@index([provider_profile_id], map: "idx_service_listings_provider")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model service_requests {
  service_request_id        BigInt                     @id @default(autoincrement())
  client_id                 BigInt
  provider_profile_id       BigInt
  source_service_listing_id BigInt?
  source_need_id            BigInt?
  proposed_datetime         DateTime                   @db.Timestamptz(6)
  neighborhood_id           Int
  exact_address             String?                    @db.VarChar(255)
  agreed_price              Decimal?                   @db.Decimal(12, 2)
  status_id                 Int                        @db.SmallInt
  rejection_reason          String?                    @db.VarChar(300)
  reschedule_count          Int                        @default(0) @db.SmallInt
  completion_requested_at   DateTime?                  @db.Timestamptz(6)
  created_at                DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                   @default(now()) @db.Timestamptz(6)
  appointments              appointments?
  cancellations             cancellations?
  chat_messages             chat_messages[]
  claims                    claims[]
  completion_confirmations  completion_confirmations[]
  issue_reports             issue_reports[]
  notifications             notifications[]
  ratings                   ratings[]
  users                     users                      @relation(fields: [client_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  neighborhoods             neighborhoods              @relation(fields: [neighborhood_id], references: [neighborhood_id], onDelete: NoAction, onUpdate: NoAction)
  provider_profiles         provider_profiles          @relation(fields: [provider_profile_id], references: [provider_profile_id], onDelete: NoAction, onUpdate: NoAction)
  needs                     needs?                     @relation(fields: [source_need_id], references: [need_id], onDelete: NoAction, onUpdate: NoAction)
  service_listings          service_listings?          @relation(fields: [source_service_listing_id], references: [service_listing_id], onDelete: NoAction, onUpdate: NoAction)
  request_statuses          request_statuses           @relation(fields: [status_id], references: [request_status_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([client_id, status_id], map: "idx_service_requests_client_status")
  @@index([provider_profile_id, status_id], map: "idx_service_requests_provider_status")
  @@index([source_service_listing_id], map: "idx_service_requests_source_listing")
  @@index([source_need_id], map: "idx_service_requests_source_need")
}

