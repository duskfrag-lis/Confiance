NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

DATABASE_URL="postgresql://confiance:confiance@localhost:5432/confiance?schema=public"

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

STORAGE_ENDPOINT=localhost
STORAGE_PORT=8333
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=confiance

RESEND_API_KEY=
MAIL_FROM="Confiance <no-reply@confiance.app>"

# URL de la SPA: destino de los enlaces de correo y de las redirecciones
FRONTEND_URL=http://localhost:4200
# URL pública de la API: base del enlace de verificación de correo
API_PUBLIC_URL=http://localhost:3000/api

# Clave secreta de reCAPTCHA. La de abajo es la clave de prueba pública de Google
# (siempre valida); en producción va la clave real del proyecto.
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# OAuth (HU-67). Las credenciales salen de Google Cloud Console y Microsoft Entra.
# Mientras no existan, cualquier texto no vacío deja arrancar la app.
FRONTEND_URL=http://localhost:4200
GOOGLE_CLIENT_ID=pendiente
GOOGLE_CLIENT_SECRET=pendiente
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
MICROSOFT_CLIENT_ID=pendiente
MICROSOFT_CLIENT_SECRET=pendiente
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback
# consumers = solo cuentas personales (correo verificado por Microsoft, D-38)
MICROSOFT_TENANT=consumers